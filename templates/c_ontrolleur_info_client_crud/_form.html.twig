{{ form_start(form) }}
    <div class="row">
        <div class="col-12 col-md-8">
            <h2>Informations Client</h2>
            <div class="row">
                <div class="col-12 col-md-6">{{ form_row(form.prenom) }}</div>
                <div class="col-12 col-md-6">{{ form_row(form.nom) }}</div>
            </div>
            <div class="row">
                <div class="col-6">{{ form_row(form.docteur) }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <h2>Liste de vos rendez-vous</h2>
        </div>
    </div>
    {{ form_widget(form) }}
    <button class="btn">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
