<form method="post" action="{{ path('app_c_ontrolleur_info_client_crud_delete', {'id': info_client.id}) }}" onsubmit="return confirm('Etes vous sur de vouloir supprimer le client : {{ info_client.nom }} {{ info_client.prenom }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ info_client.id) }}">
    <button class="btn">Supprimer le client</button>
</form>
